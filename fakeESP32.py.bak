
from flask import Flask, jsonify
import random
import time
import paho.mqtt.client as mqtt
from threading import Thread
import certifi
from dotenv import load_dotenv
import os
from datetime import datetime, timezone

# Load environment variables
load_dotenv()

# Flask config
HOST = '127.0.0.1'
PORT = 5100

# MQTT Config
MQTT_BROKER = "c29162f3d8f24ad1ae54157ddb08596c.s1.eu.hivemq.cloud"
MQTT_PORT = 8883
MQTT_USERNAME = os.getenv("HIVE_USERNAME")
MQTT_PASSWORD = os.getenv("HIVE_PASSWORD")

# Validate MQTT credentials
if not MQTT_USERNAME or not MQTT_PASSWORD:
    raise ValueError("Missing MQTT credentials in .env file")

# For Flask endpoint
latest_sensor_values = {}

# Generate random sensor values
def generate_sensor_values(farmerId, fieldId):
    return {
        "temperature": round(random.uniform(20.0, 35.0), 2),
        "humidity": round(random.uniform(40.0, 80.0), 2),
        "soil_moisture": round(random.uniform(0.0, 100.0), 2),
        "light_intensity": round(random.uniform(100.0, 1000.0), 2),
        "farmerId": farmerId,
        "fieldId": fieldId,
        "timeStamp": datetime.now(timezone.utc).isoformat()
    }

# Function to send MQTT messages for a specific topic, farmer, and field
def sensor_publisher_loop(farmerId, fieldId, topic, interval):
    client = mqtt.Client()
    client.username_pw_set(MQTT_USERNAME, MQTT_PASSWORD)
    client.tls_set(ca_certs=certifi.where())
    client.connect(MQTT_BROKER, MQTT_PORT, 60)

    while True:
        sensor_data = generate_sensor_values(farmerId, fieldId)
        client.publish(topic, str(sensor_data))
        print(f"[{farmerId}-{fieldId}] Published to {topic}: {sensor_data}")
        latest_sensor_values[f"{farmerId}_{fieldId}"] = sensor_data
        time.sleep(interval)

# Flask app
app = Flask(__name__)

@app.route('/values/json', methods=['GET'])
def get_sensor_values_json():
    if latest_sensor_values:
        return jsonify(latest_sensor_values)
    else:
        return {"error": "No data available"}, 404

if __name__ == "__main__":
    # Start independent threads for each publisher
    threads = [
        Thread(target=sensor_publisher_loop, args=("fr1", "fd1", "topic_farmer1", 5), daemon=True),
        Thread(target=sensor_publisher_loop, args=("fr1", "fd2", "topic_farmer1", 5), daemon=True),
        Thread(target=sensor_publisher_loop, args=("fr2", "fd3", "topic_farmer2", 5), daemon=True)
    ]

    for t in threads:
        t.start()

    # Start Flask server
    app.run(host=HOST, port=PORT)
